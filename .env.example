# --- Search (Tavily) ---
JORYU_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# --- Weather (Open-Meteo, key not required) ---
JORYU_WEATHER_PROVIDER=open_meteo

# --- Fetch URL ---
JORYU_FETCH_TIMEOUT=5
JORYU_FETCH_MAX_BYTES=512000

# --- MCP ---
JORYU_MCP_ENABLED=false
JORYU_MCP_URL=http://localhost:8200

# --- Screening judge (joryu-judge / Curate) — 任意 ---
# GGUF: https://huggingface.co/mradermacher/Llama-3.1-Swallow-8B-Instruct-v0.5-GGUF
# 元モデル: https://huggingface.co/tokyotech-llm/Llama-3.1-Swallow-8B-Instruct-v0.5
# 公開リポジトリのため通常は不要。レート制限回避などで Read トークンを渡す場合のみ設定
HF_TOKEN=
